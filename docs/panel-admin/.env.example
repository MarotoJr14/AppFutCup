## Backend API base URL for the admin panel
# Dev (local backend):
# VITE_API_BASE_URL=http://localhost:8000/api/v1
#
# If you serve the admin panel behind the same origin as the backend (reverse proxy),
# you can omit this and it will default to `${window.location.origin}/api/v1` in production.
VITE_API_BASE_URL=http://localhost:8000/api/v1

